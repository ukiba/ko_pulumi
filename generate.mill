package build

import JavacSyntax.*

import com.sun.source.tree.ClassTree
import com.sun.source.doctree.DeprecatedTree
import com.sun.source.util.{DocTrees, TreePathScanner, JavacTask}

import scala.jdk.StreamConverters.*
import scala.jdk.CollectionConverters.*
import scala.util.Using
import javax.lang.model.`type`.{TypeMirror, ArrayType}
import javax.lang.model.element.{Element, ElementKind, TypeElement, ExecutableElement, AnnotationValue, Modifier}
import javax.lang.model.util.{Elements, Types}
import javax.tools.{ToolProvider, DiagnosticCollector, Diagnostic, JavaFileObject}
import java.nio.file.{Path, Files}
import java.nio.charset.StandardCharsets.UTF_8
import java.io.File.pathSeparator
import java.util.Locale.ENGLISH

class PulumiProviderAdapterGenerator(dstRoot: Path, packageName: String, classpath: Seq[String]):
  def processDirectory(srcRoot: Path): Seq[Path] =
    val packageMembers = scan(srcRoot)

    // the generated file and object are named by the last package component
    val collisions = packageMembers.keys.groupBy(_.last).values.filter(_.size > 1)
    if collisions.nonEmpty then
      throw IllegalStateException("packages with the same last component: " +
          collisions.map(_.map(_.mkString(".")).toSeq.sorted.mkString(", ")).toSeq.sorted.mkString("; "))

    // rendered in memory before writing, so that a failure does not leave a mix of new and old files
    val extObjects = extObjectsOf(packageMembers)
    val contents = renderPackageFiles(packageMembers) ++ renderExtFiles(extObjects) :+
        renderSyntaxFile(extObjects, packageMembers)
    val written = contents.map(writeIfChanged).sorted
    deleteStaleFiles(written)
    written

  // unchanged files are not rewritten, so that their mtime is kept and editors don't see them as changed
  def writeIfChanged(file: Path, content: String): Path =
    if !(Files.isRegularFile(file) && Files.readString(file) == content) then  // UTF_8
      Option(file.getParent).foreach: parentDir =>
        if !Files.isDirectory(parentDir) then  // createDirectories throws if a symlink to a directory
          Files.createDirectories(parentDir)
      Files.writeString(file, content)  // UTF_8
    file

  // delete *.scala files no longer generated,
  // e.g. for a removed package or for a `<pkg>_ext` object left without extensions.
  // directories are left, so that an editor with a deleted file open is not confused
  def deleteStaleFiles(written: Seq[Path]): Unit =
    val writtenSet = written.map(_.toAbsolutePath.normalize).toSet
    val stale = Using.resource(Files.walk(dstRoot)):
      _.toScala(Seq).filter: path =>
        Files.isRegularFile(path) && path.getFileName.toString.endsWith(".scala") &&
            !writtenSet.contains(path.toAbsolutePath.normalize)
    stale.foreach(Files.delete)

  // the key is package components
  def scan(srcRoot: Path): Map[Seq[String], Vector[Member]] =
    def isJavaFile(path: Path) = Files.isRegularFile(path) && path.getFileName.toString.toLowerCase.endsWith(".java")
    val files = Using.resource(Files.walk(srcRoot))(_.toScala(Seq).filter(isJavaFile).sorted)

    // Vector since List append performs bad with thousands of classes
    val packageMembers = collection.mutable.Map.empty[Seq[String], Vector[Member]].withDefaultValue(Vector())

    val compiler = ToolProvider.getSystemJavaCompiler
    def getStandardFileManager = compiler.getStandardFileManager(
      null,  // diagnosticListener
      ENGLISH,
      UTF_8,
    )
    val diagnostics = DiagnosticCollector[JavaFileObject]()
    Using.resource(getStandardFileManager): fileManager =>
      val task = compiler.getTask(
        null,  // out
        fileManager,
        diagnostics,
        Seq(
          // avoid `error: cannot find symbol` in analyze()
          "-classpath", classpath.mkString(pathSeparator),

          "-proc:none",  // options: no annotation processors
        ).asJava,
        null,  // classes
        fileManager.getJavaFileObjectsFromPaths(files.asJava),  // compilationUnits
      ).asInstanceOf[JavacTask]

      given DocTrees = DocTrees.instance(task)  // Trees.instance(task) if getDocCommentTree is not needed
      given elements: Elements = task.getElements
      given types   : Types    = task.getTypes

      val unitTrees = task.parse()
      task.analyze()  // needed for getElement / getTypeMirror
      checkDiagnostics(diagnostics)

      Scanner(packageMembers).scan(unitTrees, ())

    packageMembers.toMap

  // fail on errors, since erroneous types silently fail the isSubtype checks, leaving members ungenerated.
  // javac stops at 100 errors by default; -Xmaxerrs is not raised, since the exact count of a broken run matters little
  def checkDiagnostics(diagnostics: DiagnosticCollector[JavaFileObject]): Unit =
    val (errors, others) = diagnostics.getDiagnostics.asScala.partition(_.getKind == Diagnostic.Kind.ERROR)
    others.foreach(System.err.println)  // as javac would print without a listener
    if errors.nonEmpty then
      val maxShown = 10
      throw IllegalStateException(s"javac reported ${errors.size} errors (pulumiProviderJars incomplete?):\n" +
          errors.take(maxShown).mkString("\n") + (if errors.size > maxShown then "\n..." else ""))

  // one file per package, without the extensions (see extObjectsOf)
  def renderPackageFiles(packageMembers: Map[Seq[String], Vector[Member]]): Seq[(Path, String)] =
    packageMembers.toSeq.flatMap: (packageComps, allMembers) =>
      val members = allMembers.filterNot(_.isInstanceOf[ResourceArgsMember])
      Option.when(members.nonEmpty)(renderPackageFile(packageComps, members))

  def renderPackageFile(packageComps: Seq[String], members: Vector[Member]): (Path, String) =
    val scalaFile = dstRoot.resolve(s"${packageComps.last}.scala")

    val resourcesTypeNames =
      Option.when(members.exists(_.isInstanceOf[CustomResourceMember]))("com.pulumi.resources.CustomResourceOptions")
    val functionsTypeNames = members.collect:
      case member: FunctionsMember => member.importedTypeNames
    val importedTypeNames = (resourcesTypeNames.toSeq ++ functionsTypeNames.flatten).distinct.sorted
    val imports = importedTypeNames.map(typeName => s"\nimport $typeName").mkString

    val header = s"""
      |package jp.ukiba.ko_pulumi
      |package $packageName
      |$imports
      |
      |object ${packageComps.last}:
      |""".stripMargin.dropWhile(_ == '\n')  // drop the leading empty line
    (scalaFile, header + members.map(_.text).mkString("\n"))

  /*
    The extensions of a package are in `object <pkg>_ext`, apart from its resources and functions, so that an
    extension method named `identity` (e.g. gcp.storage) does not shadow the `identity` in their default arguments.
    Users don't see the name, since syntax.all exports the methods.

    No object or syntax file is split by size. Splitting kept classes below JVM's per-class limit of 65535 constant
    pool entries: the extensions into `<pkg>_ext1`, `<pkg>_ext2`, ..., and the syntax file by method name.
    It is not needed, since inline methods emit no bytecode: the largest generated class,
    cloudflare's CloudflareFunctions$ with the getters of the default arguments, takes 27% of the limit.
  */
  case class ExtObject(name: String, members: Vector[ResourceArgsMember])

  def extObjectsOf(packageMembers: Map[Seq[String], Vector[Member]]): Seq[ExtObject] =
    packageMembers.toSeq.flatMap: (packageComps, members) =>
      val extMembers = members.collect:
        case member: ResourceArgsMember => member
      Option.when(extMembers.nonEmpty)(ExtObject(s"${packageComps.last}_ext", extMembers))

  def renderExtFiles(extObjects: Seq[ExtObject]): Seq[(Path, String)] =
    extObjects.map: extObject =>
      val header = s"""
        |package jp.ukiba.ko_pulumi
        |package $packageName
        |
        |object ${extObject.name}:
        |""".stripMargin.dropWhile(_ == '\n')  // drop the leading empty line
      (dstRoot.resolve(s"${extObject.name}.scala"), header + extObject.members.map(_.text).mkString("\n"))

  // support `jp.ukiba.ko_pulumi.$packageName.syntax.all.*`, in one file (see ExtObject for why it is not split)
  def renderSyntaxFile(extObjects: Seq[ExtObject],
      packageMembers: Map[Seq[String], Vector[Member]]): (Path, String) =
    case class ExtMethod(cls: String, method: String)
    object ExtMethod:
      given Ordering[ExtMethod] = Ordering.by(e => (e.cls, e.method))

    // CustomResourceMember is not exported,
    // to avoid `two or more overloaded variants of method Cluster have default arguments`
    // for ecs.Cluster, eks.Cluster, rds.Cluster, redshift.Cluster, msk.Cluster, ...
    // they would be referenced with the prefix
    val exportedExtMethods = (for
      extObject <- extObjects
      member    <- extObject.members
      name      <- member.names
    yield ExtMethod(extObject.name, name)).toSet
    val exportedFuncs = (for
      (packageComps, members) <- packageMembers.toSeq
      case FunctionsMember(_, name, _) <- members
    yield s"${packageComps.last}.$name").toSet

    val header = s"""
      |package jp.ukiba.ko_pulumi.$packageName.syntax.all
      |
      |import jp.ukiba.ko_pulumi
      |
      |""".stripMargin.dropWhile(_ == '\n')  // drop the leading empty line

    val funcExports = exportedFuncs.toSeq.sorted.map: func =>
      s"export ko_pulumi.$packageName.$func\n"
    val extExports = exportedExtMethods.toSeq.sorted.map: extMethod =>
      s"export ko_pulumi.$packageName.${extMethod.cls}.${extMethod.method}\n"

    (dstRoot.resolve("syntax/all.scala"), header + (funcExports ++ extExports).mkString)

  sealed trait Member:
    def text: String
  case class CustomResourceMember(text: String)                                              extends Member
  case class ResourceArgsMember  (text: String, names: Seq[String])                          extends Member
  case class FunctionsMember     (text: String, name: String, importedTypeNames: Seq[String]) extends Member

  class Scanner(packageMembers: collection.mutable.Map[Seq[String], Vector[Member]])
      (using trees: DocTrees, elements: Elements, types: Types) extends TreePathScanner[Unit, Unit]:
    def typeElemOf(qualifiedName: String): TypeElement =
      Option(elements.getTypeElement(qualifiedName)).getOrElse:
        throw IllegalStateException(s"$qualifiedName not found in the classpath")
    def typeOf(qualifiedName: String): TypeMirror = typeElemOf(qualifiedName).asType

    val outputElem = typeElemOf("com.pulumi.core.Output")

    val stringType                = typeOf("java.lang.String")
    val deprecatedType            = typeOf("java.lang.Deprecated")
    val stringMapType             = types.getDeclaredType(typeElemOf("java.util.Map"), stringType, stringType)
    val outputStringMapType       = types.getDeclaredType(outputElem, stringMapType)
    val customResourceOptionsType = typeOf("com.pulumi.resources.CustomResourceOptions")
    val invokeOptionsElem         = typeElemOf("com.pulumi.deployment.InvokeOptions")
    val invokeOutputOptionsElem   = typeElemOf("com.pulumi.deployment.InvokeOutputOptions")

    // erased; excludes com.pulumi.aws.appstream.ImageBuilderArgs.builder(ImageBuilderArgs)
    val functionResultTypes =
        Seq(outputElem.asType, typeOf("java.util.concurrent.CompletableFuture")).map(types.erasure)

    val customResourceType = typeOf("com.pulumi.resources.CustomResource")  // also the superclass of ProviderResource

    val argsSuperclasses = Seq(  // TODO subclasses of InputArgs
      typeOf("com.pulumi.resources.ResourceArgs"),
      typeOf("com.pulumi.resources.InvokeArgs"),
      typeOf("com.pulumi.resources.CallArgs"),
    )
    def isArgsType(typeMirror: TypeMirror) = argsSuperclasses.exists(types.isSubtype(typeMirror, _))

    // super.visitClass is not called, so nested classes (e.g. Builder) are not visited;
    // they are reached through their enclosing class instead (see builderOf)
    override def visitClass(cls: ClassTree, param: Unit) =
      val currentPath = getCurrentPath
      val clsElem = trees.getElement(currentPath).asInstanceOf[TypeElement]
      if clsElem.getKind == ElementKind.CLASS then  // not INTERFACE, ENUM, RECORD, or annotation type
        val packageComps = currentPath.getCompilationUnit.getPackageName match
          case null    => throw IllegalStateException("pulumi class must be in a package")
          case pkgName => pkgName.toString.split('.').toSeq

        if types.isSubtype(clsElem.asType, customResourceType) then
          genCustomResource(clsElem, packageComps)
        else if isArgsType(clsElem.asType) then
          genResourceArgs(clsElem, packageComps)
        else if clsElem.getModifiers.contains(Modifier.PUBLIC) then
          genFunctions(clsElem, packageComps)

    /*
      Generate the following code

        inline def SecurityGroup(name: String,
            resourceOptions: Endofunction[CustomResourceOptions.Builder] = identity)
            (args: Endofunction[SecurityGroupArgs.Builder] = identity)(using conf: KoPulumiConf) =
          var argsBuilder = SecurityGroupArgs.builder
          conf.logicalName2physicalName(name) match
            case Some(physicalName) => argsBuilder = argsBuilder.name(physicalName)
            case None               =>
          argsBuilder = args(argsBuilder)
          conf.logicalName2tagName(name) match
            case Some(tagName) =>
              argsBuilder = argsBuilder.tags:
                transformOptOutputMap(argsBuilder.build.tags, map =>
                    if map.contains("Name") then map else map + ("Name" -> tagName))
            case None =>
          com.pulumi.aws.ec2.SecurityGroup(name,
              argsBuilder.build,
              resourceOptions(conf.customResourceOptionsBuilder).build)

      from the pattern

        public class SecurityGroup extends com.pulumi.resources.CustomResource {
          ...

          public SecurityGroup(String name, SecurityGroupArgs args,
              com.pulumi.resources.CustomResourceOptions options) {
          ...
        }
    */
    def genCustomResource(clsElem: TypeElement, packageComps: Seq[String]) =
      val clsName = clsElem.simpleName

      // the Args type of the constructor (String name, XxxArgs args, CustomResourceOptions options)
      clsElem.enclosedElements.collect:
        case ctor: ExecutableElement if ctor.getKind == ElementKind.CONSTRUCTOR && ctor.parameters.length == 3 &&
            types.isSameType(ctor.parameters(0).asType, stringType) &&
            types.isSameType(ctor.parameters(2).asType, customResourceOptionsType) =>
          types.asElement(ctor.parameters(1).asType)  // null if primitive
      .collectFirst:
        case argsType: TypeElement if argsType.simpleName.contentEquals(s"${clsName}Args") => argsType
      .foreach: argsType =>
        val argsBuilderType = builderOf(argsType)

        val nameSetter = methodOf(argsBuilderType, "name", stringType)
        // see KoPulumiConf.logicalName2tagName for gcp
        val tagsSetter = if packageName == "gcp" then None else methodOf(argsBuilderType, "tags", outputStringMapType)
        val tagsGetter = methodOf(argsType, "tags")

        val clsDoc = scaladocOf(clsElem, indent = "  ")

        // each conf carries the methods it calls, to propagate their deprecation,
        // and its code starts with a newline, to be appended to the preceding line

        // pre-args-function propagation: args-function can override
        // Name tag is handled separately because overriding a part of Map is not straight forward
        val applyConfs = Seq(
          nameSetter.map: setter =>
            (code = """
            |    conf.logicalName2physicalName(name) match
            |      case Some(physicalName) => argsBuilder = argsBuilder.name(physicalName)
            |      case None               =>""".stripMargin, calls = Seq(setter)),

          Option.when(argsType.getQualifiedName.contentEquals("com.pulumi.aws.ecs.TaskDefinitionArgs")):
            (code = """
            |    conf.logicalName2ecsTaskDefinitionFamily(name) match
            |      case Some(family) => argsBuilder = argsBuilder.family(family)
            |      case None         =>""".stripMargin,
            calls = Seq(requiredMethod(argsBuilderType, "family", stringType))),
        ).flatten

        // post-args-function: tags set by args-function are preserved
        val mergeConfs = tagsSetter.zip(tagsGetter).map: (setter, getter) =>
          (code = """
          |    argsBuilder = args(argsBuilder)
          |    conf.logicalName2tagName(name) match
          |      case Some(tagName) =>
          |        argsBuilder = argsBuilder.tags:
          |          transformOptOutputMap(argsBuilder.build.tags, map =>
          |              if map.contains("Name") then map else map + ("Name" -> tagName))
          |      case None =>""".stripMargin, calls = Seq(setter, getter))
        .toSeq

        val confs = applyConfs ++ mergeConfs

        val clsDeprecated = deprecatedOf(clsElem)
        val deprecated =
          if clsDeprecated.nonEmpty then clsDeprecated else deprecatedCallsOf(confs.flatMap(_.calls))

        // mergeConfs apply args
        val finalArgsExpr = if mergeConfs.nonEmpty then "argsBuilder.build" else "args(argsBuilder).build"

        val resourceFuncType = s"Endofunction[CustomResourceOptions.Builder] = identity"
        // the confs reassign argsBuilder
        val builderVarOrVal = if confs.nonEmpty then "var" else "val"
        val argsTypeName = argsType.getQualifiedName
        packageMembers(packageComps) :+= CustomResourceMember(s"""
          |  ${clsDoc}${deprecated}inline def $clsName(name: String, resourceOptions: $resourceFuncType)
          |      (args: Endofunction[$argsTypeName.Builder] = identity)(using conf: KoPulumiConf) =
          |    $builderVarOrVal argsBuilder = $argsTypeName.builder${confs.map(_.code).mkString}
          |    ${clsElem.getQualifiedName}(name,
          |        $finalArgsExpr,
          |        resourceOptions(conf.customResourceOptionsBuilder).build)
          |""".stripMargin.dropWhile(_ == '\n'))  // drop the leading empty line

    /*
      Generate the following code

        extension (builder: RoleArgs.Builder)
          ...
          inline def inlinePolicies(args: Endofunction[RoleInlinePolicyArgs.Builder]*): RoleArgs.Builder =
            def argsBuilder = RoleInlinePolicyArgs.builder
            builder.inlinePolicies(args.map(_(argsBuilder).build)*)
          ...

      from the pattern

        public class RoleArgs extends com.pulumi.resources.ResourceArgs {
          ...
          public static class Builder {
            ...
            public Builder inlinePolicies(RoleInlinePolicyArgs... inlinePolicies) {
                return inlinePolicies(List.of(inlinePolicies));
            }
            ...
          }
          ...
        }
    */
    def genResourceArgs(argsType: TypeElement, packageComps: Seq[String]) =
      val argsBuilderType = builderOf(argsType)

      val argsBuilderMembers = argsBuilderType.enclosedElements  // directly declared and mandated
      val argsBuilderMethods = argsBuilderMembers.collect:
        case method: ExecutableElement if method.getKind == ElementKind.METHOD && method.parameters.length == 1 =>
          (method, method.parameters.head.asType)
      .collect:
        case (method, paramType: ArrayType) if isArgsType(paramType.componentType) =>
          (method = method, argsType = paramType.componentType, isVararg = true)
        case (method, paramType) if isArgsType(paramType) =>
          (method = method, argsType = paramType, isVararg = false)

      if argsBuilderMethods.nonEmpty then
        val packageCompsWithoutInputs = packageComps.last match
          case "inputs" => packageComps.init
          case _        => packageComps
        val extMethods = argsBuilderMethods.map: (method, argsType, isVararg) =>
          val methodName = escapeScalaKeyword(method.simpleName.toString)

          val methodDoc = scaladocOf(method, indent = "    ")

          val deprecated = deprecatedOf(method)

          val argsTypeName = renderScalaType(argsType)
          val argsFuncType = s"Endofunction[$argsTypeName.Builder]"
          if !isVararg then
            s"""
              |    ${methodDoc}${deprecated}inline def $methodName(args: $argsFuncType):
              |        ${renderScalaType(method.returnType)} =
              |      val argsBuilder = $argsTypeName.builder
              |      builder.$methodName(args(argsBuilder).build)
              |""".stripMargin
          else
            s"""
              |    ${methodDoc}${deprecated}inline def $methodName(args: $argsFuncType*):
              |        ${renderScalaType(method.returnType)} =
              |      def argsBuilder = $argsTypeName.builder
              |      builder.$methodName(args.map(_(argsBuilder).build)*)
              |""".stripMargin
        .mkString

        packageMembers(packageCompsWithoutInputs) :+= ResourceArgsMember(
            s"  extension (builder: ${argsBuilderType.getQualifiedName})$extMethods",
            argsBuilderMethods.map(_.method.simpleName.toString).map(escapeScalaKeyword).toSeq)

    /*
      Generate the following code

        object Ec2Functions:
          ...
          inline def getAmi(args: Endofunction[GetAmiArgs.Builder] = identity,
              invokeOptions: Endofunction[InvokeOutputOptions.Builder] = identity):
              com.pulumi.core.Output[GetAmiResult] =
            val argsBuilder = GetAmiArgs.builder
            com.pulumi.aws.ec2.Ec2Functions.getAmi(args(argsBuilder).build,
                invokeOptions(InvokeOutputOptions.Builder()).build)
          ...

      from the pattern

        public class Ec2Functions {
          ...
          public static Output<GetAmiResult> getAmi(GetAmiArgs args, InvokeOutputOptions options) {
          ...
          public static CompletableFuture<GetAmiResult> getAmiPlain(GetAmiPlainArgs args, InvokeOptions options) {
          ...
        }

      The Output form takes InvokeOutputOptions, which adds dependsOn. The InvokeOutputOptions overload returns
      an unknown result while a resource the args come from has an unknown ID (e.g. during preview of a resource
      to be created), unlike the single-argument method, which passes InvokeOptions.Empty.
    */
    def genFunctions(clsElem: TypeElement, packageComps: Seq[String]) =
      val clsName = clsElem.simpleName

      // static Output<GetAmiResult> getAmi(GetAmiArgs args)
      val functionMethods = clsElem.enclosedElements.collect:
        case method: ExecutableElement if method.getKind == ElementKind.METHOD &&
            method.getModifiers.contains(Modifier.STATIC) &&
            functionResultTypes.exists(types.isSameType(types.erasure(method.returnType), _)) &&
            method.parameters.length == 1 &&
            Option(types.asElement(method.parameters.head.asType))  // null if primitive
              .exists(_.simpleName.contentEquals(s"${method.simpleName.toString.withUpperCaseHead}Args")) =>
          method

      if functionMethods.nonEmpty then
        val functions = functionMethods.map: method =>
          val methodName = escapeScalaKeyword(method.simpleName.toString)

          val methodDoc = scaladocOf(method, indent = "    ")

          val deprecated = deprecatedOf(method)

          val argsType = renderScalaType(method.parameters.head.asType)
          val isOutputForm = types.isSameType(types.erasure(method.returnType), types.erasure(outputElem.asType))
          val (optionsElem, optionsBuilderExpr) =
            if isOutputForm then
              (invokeOutputOptionsElem, "InvokeOutputOptions.Builder()")  // no static builder method
            else
              (invokeOptionsElem, "InvokeOptions.builder")
          requiredMethod(clsElem, method.simpleName.toString, method.parameters.head.asType, optionsElem.asType)

          // Pulumi methods are reproduced as Scala methods.
          // Java methods cause Scala warnings under -Yexplicit-nulls flag
          // when the return value is assigned to class member without explicit type, e.g.:
          //
          //     value foo exposes a flexible type in its inferred result type com.pulumi.core.Output[(String)?]. Consider annotating the type explicitly
          val argsFuncType = s"Endofunction[$argsType.Builder] = identity"
          val invokeOptionsFuncType = s"Endofunction[${optionsElem.simpleName}.Builder] = identity"
          val text = s"""
            |    ${methodDoc}${deprecated}inline def $methodName(args: $argsFuncType,
            |        invokeOptions: $invokeOptionsFuncType):
            |        ${renderScalaType(method.returnType)} =
            |      val argsBuilder = $argsType.builder
            |      ${clsElem.getQualifiedName}.$methodName(args(argsBuilder).build,
            |          invokeOptions($optionsBuilderExpr).build)
            |""".stripMargin
          (text = text, importedTypeName = optionsElem.getQualifiedName.toString)

        packageMembers(packageComps) :+= FunctionsMember(s"  object $clsName:" + functions.map(_.text).mkString,
          clsName.toString,
          functions.map(_.importedTypeName).distinct.toSeq)

    def builderOf(argsType: TypeElement): TypeElement =
      argsType.enclosedElements.collectFirst:
        case elem: TypeElement if elem.getKind == ElementKind.CLASS && elem.simpleName.contentEquals("Builder") => elem
      .getOrElse:
        throw IllegalStateException(s"pulumi Args class must have Builder inner class: $argsType")

    // directly declared (not inherited)
    def methodOf(owner: TypeElement, name: String, paramTypes: TypeMirror*): Option[ExecutableElement] =
      owner.enclosedElements.collectFirst:
        case method: ExecutableElement if method.getKind == ElementKind.METHOD &&
            method.simpleName.contentEquals(name) &&
            method.parameters.length == paramTypes.length &&
            method.parameters.zip(paramTypes).forall((param, paramType) => types.isSameType(param.asType, paramType)) =>
          method

    def requiredMethod(owner: TypeElement, name: String, paramTypes: TypeMirror*): ExecutableElement =
      methodOf(owner, name, paramTypes*).getOrElse:
        throw IllegalStateException(s"$owner must have $name(${paramTypes.mkString(", ")})")

    // without the examples, which are long and don't use the improved syntax
    def scaladocOf(elem: Element, indent: String): String =
      Option(trees.getDocCommentTree(elem)).map: docTree =>
        val lines = docTree.toString.split('\n').toSeq.takeWhile(_.trim != "## Example Usage")
        scaladoc(lines, indent)
      .mkString

    // annotation is needed since @deprecated tag in scaladoc does not suppress the deprecated warnings
    def deprecatedOf(elem: Element): String =
      deprecationOf(elem).map(deprecation => deprecatedAnnotation(deprecation.reason, deprecation.since)).mkString

    // deprecated if a called method is, so that the warning is shown to the users instead of the caller
    // (like javac, scalac does not warn inside deprecated members)
    def deprecatedCallsOf(calledMethods: Seq[ExecutableElement]): String =
      val deprecatedMethods = calledMethods.distinct.flatMap: method =>
        deprecationOf(method).map(deprecation => (method = method, deprecation = deprecation))
      Option.when(deprecatedMethods.nonEmpty):
        val reasons = deprecatedMethods.map: (method, deprecation) =>
          val reason = deprecation.reason.map(": " + _).mkString
          s"${method.getEnclosingElement}.${method.simpleName}$reason"
        val sinces = deprecatedMethods.flatMap(_.deprecation.since).distinct
        deprecatedAnnotation(Some(s"calls deprecated ${reasons.mkString("; ")}"),
            Option.when(sinces.nonEmpty)(sinces.mkString(", ")))
      .mkString

    def deprecatedAnnotation(message: Option[String], since: Option[String]): String =
      val args = message.map(stringLiteralOf) ++ since.map(value => s"since = ${stringLiteralOf(value)}")
      s"@deprecated(${args.mkString(", ")}) "

    // Some if @Deprecated, with its `since` element and the body of `@deprecated` Javadoc tag (whitespace collapsed)
    def deprecationOf(elem: Element): Option[(since: Option[String], reason: Option[String])] =
      elem.annotationMirrors.find(anno => types.isSameType(anno.annotationType, deprecatedType)).map: anno =>
        val since = anno.elementValues.collectFirst:
          case (method: ExecutableElement, value: AnnotationValue) if method.getSimpleName.contentEquals("since") =>
            value.getValue.asInstanceOf[String]
        val reason = Option(trees.getDocCommentTree(elem)).toSeq.flatMap(_.getBlockTags.asScala).collectFirst:
          case tag: DeprecatedTree => tag.getBody.asScala.mkString.trim.replaceAll("\\s+", " ")
        .filter(_.nonEmpty)
        (since = since, reason = reason)

  def renderScalaType(typeMirror: TypeMirror): String =
    val text = typeMirror.toString
    text.replace('<', '[').replace('>', ']')  // change the generic type parameter syntax

  def escapeScalaKeyword(ident: String): String =
    if hardKeywords.contains(ident) then s"`$ident`" else ident

  def stringLiteralOf(str: String): String = s""""${str.replace("\\", "\\\\").replace("\"", "\\\"")}""""

  private val hardKeywords = Set(
    "abstract", "case", "catch", "class", "def", "do", "else", "enum", "export", "extends",
    "false", "final", "finally", "for", "given", "if", "implicit", "import", "lazy", "match",
    "new", "null", "object", "override", "package", "private", "protected", "return",
    "sealed", "super", "then", "throw", "trait", "true", "try", "type", "val", "var", "while",
    "with", "yield", //":", "=", "<-", "=>", "<:", " >:", "#", "@", "=>>", "?=>"
  )

  def scaladoc(lines: Seq[String], indent: String): String =
    val outLines = lines
      .map(_.stripTrailing)  // remove trailing spaces from each line
      .dropWhile(_.forall(_.isWhitespace))
      .dropRightWhile(_.forall(_.isWhitespace))
      .map(_.replace("/*", "&#47;&#42;"))  // avoid `unclosed comment` error (scaladoc can be nested unlike javadoc)
      .map(_.replace("$", "\\$"))  // avoid scaladoc variable expansion, e.g. `$LATEST`
    if outLines.isEmpty then  // e.g. only examples
      ""
    else if outLines.size == 1 then
      s"/** ${outLines.head} */\n$indent"
    else
      s"${outLines.mkString(s"/**\n$indent * ", s"\n$indent * ", s"\n$indent */")}\n$indent"
