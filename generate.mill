package build

import JavacSyntax.*

import com.sun.source.tree.ClassTree
import com.sun.source.doctree.{DocCommentTree, DeprecatedTree}
import com.sun.source.util.{DocTrees, TreePathScanner, JavacTask}

import scala.jdk.StreamConverters.*
import scala.jdk.CollectionConverters.*
import scala.util.Using
import javax.lang.model.`type`.{TypeMirror, ArrayType}
import javax.lang.model.element.{Element, ElementKind, TypeElement, ExecutableElement, AnnotationValue, Modifier}
import javax.lang.model.util.{Elements, Types}
import javax.tools.ToolProvider
import java.nio.file.{Path, Files}
import java.nio.charset.StandardCharsets.UTF_8
import java.io.File.pathSeparator
import java.io.Writer
import java.util.Locale.ENGLISH

class PulumiProviderAdapterGenerator(dstRoot: Path, packageName: String, classpath: Seq[String]):
  def processDirectory(srcRoot: Path): Seq[Path] =
    scan(srcRoot)
    (writePackageFiles() ++ writeSyntaxFiles()).sorted

  def scan(srcRoot: Path): Unit =
    def isJavaFile(path: Path) = !Files.isDirectory(path) && path.getFileName.toString.toLowerCase.endsWith(".java")
    val files = Using.resource(Files.walk(srcRoot))(_.toScala(Seq).filter(isJavaFile).sorted)

    val compiler = ToolProvider.getSystemJavaCompiler
    def getStandardFileManager = compiler.getStandardFileManager(
      null,  // diagnosticListener
      ENGLISH,
      UTF_8,
    )
    Using.resource(getStandardFileManager): fileManager =>
      val task = compiler.getTask(
        null,  // out
        fileManager,
        null,  // diagnosticListener
        Seq(
          // avoid `error: cannot find symbol` in analyze() (they may be harmless though)
          "-classpath", classpath.mkString(pathSeparator),

          "-proc:none",  // options: no annotation processors
        ).asJava,
        null,  // classes
        fileManager.getJavaFileObjectsFromPaths(files.asJava),  // compilationUnits
      ).asInstanceOf[JavacTask]

      given DocTrees = DocTrees.instance(task)  // Trees.instance(task) if getDocCommentTree is not needed
      given elements: Elements = task.getElements
      given types   : Types    = task.getTypes

      val unitTrees = task.parse()
      task.analyze()  // needed for getElement / getTypeMirror

      Scanner().scan(unitTrees, ())

  // one file per package
  def writePackageFiles(): Seq[Path] =
    packageMembers.toSeq.map: (packageComps, members) =>
      val scalaFile = dstRoot.resolve(s"${packageComps.last}.scala")

      val importCustomResourceOptions =
        if members.exists(_.isInstanceOf[CustomResourceMember]) then
          "\nimport com.pulumi.resources.CustomResourceOptions"
        else
          ""

      Using.resource(newWriter(scalaFile)): writer =>
        writer.append(s"""
          |package jp.ukiba.ko_pulumi
          |package $packageName
          |$importCustomResourceOptions
          |
          |object ${packageComps.last}:
          |""".stripMargin.dropWhile(_ == '\n'))  // drop the leading empty line
        writer.append(members.map(_.text).mkString("\n"))

      scalaFile

  // support `jp.ukiba.ko_pulumi.$packageName.all.*`
  def writeSyntaxFiles(): Seq[Path] =
    case class ExtMethod(cls: String, method: String)
    object ExtMethod:
      given Ordering[ExtMethod] = Ordering.by(e => (e.cls, e.method))

    // split into multiple package files, to avoid `Class too large` error,
    // caused by JVM's per-class limit (65535 methods, 64K constant pool entries).
    case class SplitConf(range: (from: Char, to: Char), fileName: String):
      def contains(name: String): Boolean =
        val head = name.stripPrefix("`").head  // escapeScalaKeyword wraps keyword in backticks
        head >= range.from && head <= range.to
      def contains(extMethod: ExtMethod): Boolean = contains(extMethod.method)
    val splitConfs = Seq(
      SplitConf(('a', 'e'), "syntax/all_a.scala"),
      SplitConf(('f', 'j'), "syntax/all_f.scala"),
      SplitConf(('k', 'o'), "syntax/all_k.scala"),
      SplitConf(('p', 't'), "syntax/all_p.scala"),
      SplitConf(('u', 'z'), "syntax/all_u.scala"),
    )

    val `all.scala` = dstRoot.resolve(s"syntax/all.scala")

    // CustomResourceMember is not exported,
    // to avoid `two or more overloaded variants of method Cluster have default arguments`
    // for ecs.Cluster, eks.Cluster, rds.Cluster, redshift.Cluster, msk.Cluster, ...
    // they would be referenced with the prefix
    val extMethodsDedup = (for
      (packageComps, members) <- packageMembers.toSeq
      case ResourceArgsMember(_, names) <- members
      name <- names
    yield ExtMethod(packageComps.last, name)).toSet
    val funcsDedup = (for
      (packageComps, members) <- packageMembers.toSeq
      case FunctionsMember(_, name) <- members
    yield s"${packageComps.last}.$name").toSet

    // don't create empty files
    val splitFiles = splitConfs.filter(conf => extMethodsDedup.exists(conf.contains)).map: conf =>
      (conf = conf, file = dstRoot.resolve(conf.fileName))

    Using.Manager: use =>
      val mainWriter = use(newWriter(`all.scala`))
      val splitWriters = splitFiles.map: file =>
        (conf = file.conf, writer = use(newWriter(file.file)))

      (mainWriter +: splitWriters.map(_.writer)).foreach: writer =>
        writer.append(s"""
          |package jp.ukiba.ko_pulumi.$packageName.syntax.all
          |
          |import jp.ukiba.ko_pulumi
          |
          |""".stripMargin)

      funcsDedup.toSeq.sorted.foreach: func =>
        mainWriter.append(s"export ko_pulumi.$packageName.$func\n")

      splitWriters.foreach: writer =>
        extMethodsDedup.filter(writer.conf.contains).toSeq.sorted.foreach: extMethod =>
          writer.writer.append(s"export ko_pulumi.$packageName.${extMethod.cls}.${extMethod.method}\n")

    `all.scala` +: splitFiles.map(_.file)

  sealed trait Member:
    def text: String
  case class CustomResourceMember(text: String)                     extends Member
  case class ResourceArgsMember  (text: String, names: Seq[String]) extends Member
  case class FunctionsMember     (text: String, name: String)       extends Member

  // the key is package components; Vector since List append performs bad with thousands of classes
  val packageMembers = collection.mutable.Map.empty[Seq[String], Vector[Member]].withDefaultValue(Vector())

  class Scanner(using trees: DocTrees, elements: Elements, types: Types) extends TreePathScanner[Unit, Unit]:
    object elems:
      val `java.lang.String`                      = elements.getTypeElement("java.lang.String")
      val `java.lang.Deprecated`                  = elements.getTypeElement("java.lang.Deprecated")
      val `java.util.Map`                         = elements.getTypeElement("java.util.Map")
      val `com.pulumi.core.Output`                = elements.getTypeElement("com.pulumi.core.Output")
      val `java.util.concurrent.CompletableFuture` = elements.getTypeElement("java.util.concurrent.CompletableFuture")
      val `com.pulumi.resources.CustomResource`   = elements.getTypeElement("com.pulumi.resources.CustomResource")
      val `com.pulumi.resources.ProviderResource` = elements.getTypeElement("com.pulumi.resources.ProviderResource")
      val `com.pulumi.resources.CustomResourceOptions` =
          elements.getTypeElement("com.pulumi.resources.CustomResourceOptions")
      val `com.pulumi.resources.ResourceArgs`     = elements.getTypeElement("com.pulumi.resources.ResourceArgs")
      val `com.pulumi.resources.InvokeArgs`       = elements.getTypeElement("com.pulumi.resources.InvokeArgs")
      val `com.pulumi.resources.CallArgs`         = elements.getTypeElement("com.pulumi.resources.CallArgs")

    // types
    val `java.lang.String`     = elems.`java.lang.String`    .asType
    val `java.lang.Deprecated` = elems.`java.lang.Deprecated`.asType
    val `java.util.Map<java.lang.String,java.lang.String>` =
        types.getDeclaredType(elems.`java.util.Map`, `java.lang.String`, `java.lang.String`)
    val `com.pulumi.core.Output<java.util.Map<java.lang.String,java.lang.String>>` =
        types.getDeclaredType(elems.`com.pulumi.core.Output`, `java.util.Map<java.lang.String,java.lang.String>`)
    val `com.pulumi.resources.CustomResource`   = elems.`com.pulumi.resources.CustomResource`  .asType
    val `com.pulumi.resources.ProviderResource` = elems.`com.pulumi.resources.ProviderResource`.asType
    val `com.pulumi.resources.CustomResourceOptions` = elems.`com.pulumi.resources.CustomResourceOptions`.asType

    val argsSuperclasses = Seq(  // TODO subclasses of InputArgs
      elems.`com.pulumi.resources.ResourceArgs`.asType,
      elems.`com.pulumi.resources.InvokeArgs`  .asType,
      elems.`com.pulumi.resources.CallArgs`    .asType,
    )
    def isArgsType(typeMirror: TypeMirror) = argsSuperclasses.exists(types.isSubtype(typeMirror, _))

    override def visitClass(cls: ClassTree, param: Unit) =
      val currentPath = getCurrentPath
      val clsElem = trees.getElement(currentPath).asInstanceOf[TypeElement]
      if clsElem.getKind == ElementKind.CLASS then  // not INTERFACE, ENUM, RECORD, or annotation type
        val packageComps = currentPath.getCompilationUnit.getPackageName match
          case null    => throw IllegalStateException("pulumi class must be in a package")
          case pkgName => pkgName.toString.split('.').toSeq

        if clsElem.superclass.exists(superclass =>
            types.isSameType(superclass, `com.pulumi.resources.CustomResource`) ||
            types.isSameType(superclass, `com.pulumi.resources.ProviderResource`)) then
          genCustomResource(clsElem, packageComps)
        else if clsElem.superclass.exists(superclass => argsSuperclasses.exists(types.isSameType(superclass, _))) then
          genResourceArgs(clsElem, packageComps)
        else if clsElem.getModifiers.contains(Modifier.PUBLIC) then
          genFunctions(clsElem, packageComps)

    /*
      Generate the following code

        def SecurityGroup(name: String,
            resourceOptions: Endofunction[CustomResourceOptions.Builder] = identity)
            (args: Endofunction[SecurityGroupArgs.Builder] = identity)(using conf: KoPulumiConf) =
          var argsBuilder = SecurityGroupArgs.builder
          conf.logicalName2physicalName(name) match
            case Some(physicalName) => argsBuilder = argsBuilder.name(physicalName)
            case None               =>
          argsBuilder = args(argsBuilder)
          conf.logicalName2tagName(name) match
            case Some(tagName) =>
              argsBuilder = argsBuilder.tags:
                transformOptOutputMap(argsBuilder.build.tags, map =>
                    if map.contains("Name") then map else map + ("Name" -> tagName))
            case None =>
          com.pulumi.aws.ec2.SecurityGroup(name,
              argsBuilder.build,
              resourceOptions(CustomResourceOptions.builder.protect(conf.defaultProtect)).build)

      from the pattern

        public class SecurityGroup extends com.pulumi.resources.CustomResource {
          ...

          public SecurityGroup(String name, SecurityGroupArgs args,
              com.pulumi.resources.CustomResourceOptions options) {
          ...
        }
    */
    def genCustomResource(clsElem: TypeElement, packageComps: Seq[String]) =
      val clsName = clsElem.simpleName

      // the Args type of the constructor (String name, XxxArgs args, CustomResourceOptions options)
      clsElem.enclosedElements.collectFirst:
        case ctor: ExecutableElement if ctor.getKind == ElementKind.CONSTRUCTOR && ctor.parameters.length == 3 &&
            types.isSameType(ctor.parameters(0).asType, `java.lang.String`) &&
            types.isSameType(ctor.parameters(2).asType, `com.pulumi.resources.CustomResourceOptions`) &&
            types.asElement(ctor.parameters(1).asType).simpleName.contentEquals(s"${clsName}Args") =>
          types.asElement(ctor.parameters(1).asType).asInstanceOf[TypeElement]
      match
        case Some(argsType) =>
          val argsBuilderType = builderOf(argsType)

          val nameSetter = methodOf(argsBuilderType, "name", `java.lang.String`)
          val argsBuilderHasTags =
              methodOf(argsBuilderType, "tags", `java.util.Map<java.lang.String,java.lang.String>`).nonEmpty

          val clsDoc = scaladocWithoutExamples(trees.getDocCommentTree(clsElem), indent = "  ")

          // each conf carries the methods it calls, to propagate their deprecation,
          // and its code starts with a newline, to be appended to the preceding line

          // pre-args-function propagation: args-function can override
          // Name tag is handled separately because overriding a part of Map is not straight forward
          val applyConfs = Seq(
            nameSetter.map: setter =>
              (code = """
              |    conf.logicalName2physicalName(name) match
              |      case Some(physicalName) => argsBuilder = argsBuilder.name(physicalName)
              |      case None               =>""".stripMargin, calls = Seq(setter)),

            Option.when(argsType.getQualifiedName.contentEquals("com.pulumi.aws.ecs.TaskDefinitionArgs")):
              (code = """
              |    conf.logicalName2ecsTaskDefinitionFamily(name) match
              |      case Some(family) => argsBuilder = argsBuilder.family(family)
              |      case None         =>""".stripMargin,
              calls = Seq(requiredMethod(argsBuilderType, "family", `java.lang.String`))),
          ).flatten

          // post-args-function: tags set by args-function are preserved
          val mergeConfs = Option.when(argsBuilderHasTags):
            (code = """
            |    argsBuilder = args(argsBuilder)
            |    conf.logicalName2tagName(name) match
            |      case Some(tagName) =>
            |        argsBuilder = argsBuilder.tags:
            |          transformOptOutputMap(argsBuilder.build.tags, map =>
            |              if map.contains("Name") then map else map + ("Name" -> tagName))
            |      case None =>""".stripMargin, calls = Seq(
              requiredMethod(argsBuilderType, "tags",
                  `com.pulumi.core.Output<java.util.Map<java.lang.String,java.lang.String>>`),
              requiredMethod(argsType, "tags")))
          .toSeq

          val confs = applyConfs ++ mergeConfs

          val clsDeprecated = deprecatedOf(clsElem)
          val deprecated =
            if clsDeprecated.nonEmpty then clsDeprecated else deprecatedCallsOf(confs.flatMap(_.calls))

          val finalArgsExpr = if argsBuilderHasTags then "argsBuilder.build" else "args(argsBuilder).build"

          // identity is qualified to avoid the collision with gcp.storage.identity
          val resourceFuncType = s"Endofunction[CustomResourceOptions.Builder] = scala.Predef.identity"
          // the confs reassign argsBuilder
          val builderVarOrVal = if confs.nonEmpty then "var" else "val"
          val argsTypeName = argsType.getQualifiedName
          packageMembers(packageComps) :+= CustomResourceMember(s"""
            |  ${clsDoc}${deprecated}def $clsName(name: String, resourceOptions: $resourceFuncType)
            |      (args: Endofunction[$argsTypeName.Builder] = scala.Predef.identity)(using conf: KoPulumiConf) =
            |    $builderVarOrVal argsBuilder = $argsTypeName.builder${confs.map(_.code).mkString}
            |    ${clsElem.getQualifiedName}(name,
            |        $finalArgsExpr,
            |        resourceOptions(CustomResourceOptions.builder.protect(conf.defaultProtect)).build)
            |""".stripMargin.dropWhile(_ == '\n'))  // drop the leading empty line
        case None =>

    /*
      Generate the following code

        extension (builder: RoleArgs.Builder)
          ...
          def inlinePolicies(args: Endofunction[RoleInlinePolicyArgs.Builder]*): RoleArgs.Builder =
            def argsBuilder = RoleInlinePolicyArgs.builder
            builder.inlinePolicies(args.map(_(argsBuilder).build)*)
          ...

      from the pattern

        public class RoleArgs extends com.pulumi.resources.ResourceArgs {
          ...
          public static class Builder {
            ...
            public Builder inlinePolicies(RoleInlinePolicyArgs... inlinePolicies) {
                return inlinePolicies(List.of(inlinePolicies));
            }
            ...
          }
          ...
        }
    */
    def genResourceArgs(argsType: TypeElement, packageComps: Seq[String]) =
      val argsBuilderType = builderOf(argsType)

      val argsBuilderMembers = argsBuilderType.enclosedElements  // directly declared and mandated
      val argsBuilderMethods = argsBuilderMembers.collect:
        case method: ExecutableElement if method.getKind == ElementKind.METHOD && method.parameters.length == 1 =>
          (method, method.parameters.head.asType)
      .collect:
        case (method, paramType: ArrayType) if isArgsType(paramType.componentType) =>
          (method = method, argsType = paramType.componentType, isVararg = true)
        case (method, paramType) if isArgsType(paramType) =>
          (method = method, argsType = paramType, isVararg = false)

      if argsBuilderMethods.nonEmpty then
        val packageCompsWithoutInputs = packageComps.last match
          case "inputs" => packageComps.init
          case _        => packageComps
        val extMethods = argsBuilderMethods.map: (method, argsType, isVararg) =>
          val methodName = escapeScalaKeyword(method.simpleName.toString)

          val methodDoc = Option(trees.getDocCommentTree(method)).map: docTree =>
            scaladoc(docTree.toString.split('\n').toSeq, indent = "    ")
          .mkString

          val deprecated = deprecatedOf(method)

          val argsFuncType = s"Endofunction[${renderScalaType(argsType)}.Builder]"
          if !isVararg then
            s"""
              |    ${methodDoc}${deprecated}def $methodName(args: $argsFuncType):
              |        ${renderScalaType(method.returnType)} =
              |      val argsBuilder = ${renderScalaType(argsType)}.builder
              |      builder.$methodName(args(argsBuilder).build)
              |""".stripMargin
          else
            s"""
              |    ${methodDoc}${deprecated}def $methodName(args: $argsFuncType*):
              |        ${renderScalaType(method.returnType)} =
              |      def argsBuilder = ${renderScalaType(argsType)}.builder
              |      builder.$methodName(args.map(_(argsBuilder).build)*)
              |""".stripMargin
        .mkString

        packageMembers(packageCompsWithoutInputs) :+= ResourceArgsMember(
            s"  extension (builder: ${argsBuilderType.getQualifiedName})$extMethods",
            argsBuilderMethods.map(_.method.simpleName.toString).map(escapeScalaKeyword).toSeq)

    /*
      Generate the following code

        object Ec2Functions:
          ...
          inline def getAmi(args: Endofunction[GetAmiArgs.Builder] = identity):
              com.pulumi.core.Output[GetAmiResult] =
            val argsBuilder = GetAmiArgs.builder
            com.pulumi.aws.ec2.Ec2Functions.getAmi(args(argsBuilder).build)
          ...

      from the pattern

        public class Ec2Functions {
          ...
          public static Output<GetAmiResult> getAmi(GetAmiArgs args) {
              return getAmi(args, InvokeOptions.Empty);
          }
          ...
        }
    */
    def genFunctions(clsElem: TypeElement, packageComps: Seq[String]) =
      val clsName = clsElem.simpleName

      // exclude com.pulumi.aws.appstream.ImageBuilderArgs.builder(ImageBuilderArgs)
      val resultTypes = Seq(elems.`com.pulumi.core.Output`, elems.`java.util.concurrent.CompletableFuture`)
          .map(elem => types.erasure(elem.asType))

      // static Output<GetAmiResult> getAmi(GetAmiArgs args)
      val functionMethods = clsElem.enclosedElements.collect:
        case method: ExecutableElement if method.getKind == ElementKind.METHOD &&
            method.getModifiers.contains(Modifier.STATIC) &&
            resultTypes.exists(types.isSameType(types.erasure(method.returnType), _)) &&
            method.parameters.length == 1 &&
            Option(types.asElement(method.parameters.head.asType))  // null if primitive
              .exists(_.simpleName.contentEquals(s"${method.simpleName.toString.withUpperCaseHead}Args")) =>
          method

      if functionMethods.nonEmpty then
        val functions = functionMethods.map: method =>
          val methodName = escapeScalaKeyword(method.simpleName.toString)

          val methodDoc = scaladocWithoutExamples(trees.getDocCommentTree(method), indent = "    ")

          val deprecated = deprecatedOf(method)

          val argsType = renderScalaType(method.parameters.head.asType)

          // identity is qualified to avoid the collision with gcp.storage.identity
          val argsFuncType = s"Endofunction[$argsType.Builder] = scala.Predef.identity"
          s"""
            |    ${methodDoc}${deprecated}inline def $methodName(args: $argsFuncType):
            |        ${renderScalaType(method.returnType)} =
            |      val argsBuilder = $argsType.builder
            |      ${clsElem.getQualifiedName}.$methodName(args(argsBuilder).build)
            |""".stripMargin
        .mkString

        packageMembers(packageComps) :+= FunctionsMember(s"""
          |  object $clsName:
          |    // Pulumi methods are reproduced as Scala methods.
          |    // Java methods cause Scala warnings under -Yexplicit-nulls flag
          |    // when the return value is assigned to class member without explicit type, e.g.:
          |    //
          |    //     value foo exposes a flexible type in its inferred result type com.pulumi.core.Output[(String)?]. Consider annotating the type explicitly
          |""".stripMargin.dropWhile(_ == '\n') + functions,  // drop the leading empty line
          clsName.toString)

    def builderOf(argsType: TypeElement): TypeElement =
      argsType.enclosedElements.collectFirst:
        case elem: TypeElement if elem.getKind == ElementKind.CLASS && elem.simpleName.contentEquals("Builder") => elem
      .getOrElse:
        throw IllegalStateException(s"pulumi Args class must have Builder inner class: $argsType")

    // directly declared (not inherited)
    def methodOf(owner: TypeElement, name: String, paramTypes: TypeMirror*): Option[ExecutableElement] =
      owner.enclosedElements.collectFirst:
        case method: ExecutableElement if method.getKind == ElementKind.METHOD &&
            method.simpleName.contentEquals(name) &&
            method.parameters.length == paramTypes.length &&
            method.parameters.zip(paramTypes).forall((param, paramType) => types.isSameType(param.asType, paramType)) =>
          method

    def requiredMethod(owner: TypeElement, name: String, paramTypes: TypeMirror*): ExecutableElement =
      methodOf(owner, name, paramTypes*).getOrElse:
        throw IllegalStateException(s"$owner must have $name(${paramTypes.mkString(", ")})")

    // the examples are long, and don't use the improved syntax
    def scaladocWithoutExamples(docTree: DocCommentTree, indent: String): String =
      Option(docTree).map: docTree =>
        val lines = docTree.toString.split('\n').toSeq.takeWhile(_.trim != "## Example Usage")
        scaladoc(lines, indent)
      .mkString

    // annotation is needed since @deprecated tag in scaladoc does not suppress the deprecated warnings
    def deprecatedOf(elem: Element): String =
      deprecatedSinceOf(elem).map: since =>
        val sinceArg = since.map(value => s"since = ${stringLiteralOf(value)}").mkString
        s"@deprecated(${sinceArg}) "  // maybe propagate anno.elementValues
      .mkString

    // deprecated if a called method is, so that the warning is shown to the users instead of the caller
    // (like javac, scalac does not warn inside deprecated members)
    def deprecatedCallsOf(calledMethods: Seq[ExecutableElement]): String =
      val deprecatedMethods = calledMethods.distinct.flatMap: method =>
        deprecatedSinceOf(method).map(since => (method = method, since = since))
      Option.when(deprecatedMethods.nonEmpty):
        val reasons = deprecatedMethods.map(_.method).map: method =>
          val reason = deprecatedReasonOf(method).map(": " + _).mkString
          s"${method.getEnclosingElement}.${method.simpleName}$reason"
        val sinces = deprecatedMethods.flatMap(_.since).distinct
        val since = Option.when(sinces.nonEmpty):
          s", since = ${stringLiteralOf(sinces.mkString(", "))}"
        .mkString
        s"@deprecated(${stringLiteralOf(s"calls deprecated ${reasons.mkString("; ")}")}$since) "
      .mkString

    // Some(since) if @Deprecated
    def deprecatedSinceOf(elem: Element): Option[Option[String]] =
      elem.annotationMirrors.find(anno => types.isSameType(anno.annotationType, `java.lang.Deprecated`)).map: anno =>
        anno.elementValues.collectFirst:
          case (method: ExecutableElement, value: AnnotationValue) if method.getSimpleName.contentEquals("since") =>
            value.getValue.asInstanceOf[String]

    // the body of `@deprecated` Javadoc tag, with whitespace collapsed
    def deprecatedReasonOf(elem: Element): Option[String] =
      Option(trees.getDocCommentTree(elem)).toSeq.flatMap(_.getBlockTags.asScala).collectFirst:
        case tag: DeprecatedTree => tag.getBody.asScala.mkString.trim.replaceAll("\\s+", " ")
      .filter(_.nonEmpty)

  def renderScalaType(typeMirror: TypeMirror): String =
    val text = typeMirror.toString
    text.replace('<', '[').replace('>', ']')  // change the generic type parameter syntax

  def escapeScalaKeyword(ident: String): String =
    if hardKeywords.contains(ident) then
      s"`$ident`"
    else
      ident

  def stringLiteralOf(str: String): String = s""""${str.replace("\\", "\\\\").replace("\"", "\\\"")}""""

  private val hardKeywords = Set(
    "abstract", "case", "catch", "class", "def", "do", "else", "enum", "export", "extends",
    "false", "final", "finally", "for", "given", "if", "implicit", "import", "lazy", "match",
    "new", "null", "object", "override", "package", "private", "protected", "return",
    "sealed", "super", "then", "throw", "trait", "true", "try", "type", "val", "var", "while",
    "with", "yield", //":", "=", "<-", "=>", "<:", " >:", "#", "@", "=>>", "?=>"
  )

  def scaladoc(lines: Seq[String], indent: String): String =
    val outLines = lines
      .map(_.dropRightWhile(_.isWhitespace).toString)  // remove trailing spaces from each line
      .dropWhile(_.forall(_.isWhitespace))
      .dropRightWhile(_.forall(_.isWhitespace))
      .map(_.replace("/*", "&#47;&#42;"))  // avoid `unclosed comment` error (scaladoc can be nested unlike javadoc)
    if outLines.size == 1 then
      s"/** ${outLines.head} */\n$indent"
    else
      s"${outLines.mkString(s"/**\n$indent * ", s"\n$indent * ", s"\n$indent */")}\n$indent"

  def newWriter(file: Path): Writer =
    Option(file.getParent).foreach: parentDir =>
      if !Files.isDirectory(parentDir) then
        Files.createDirectories(parentDir)

    Files.newBufferedWriter(file)  // UTF_8
